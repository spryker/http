{% extends '@WebProfiler/Profiler/layout.html.twig' %}

{% block toolbar %}
    {% set icon %}
        {{ include('@WebProfiler/Icon/http-client.svg') }}
        <span class="sf-toolbar-value">External Http {{ collector.logs|length }}</span>
    {% endset %}

    {% set text %}
        <div class="sf-toolbar-info-piece">
            <b>Calls</b>
            <span>{{ collector.logs|length }}</span>
        </div>
    {% endset %}

    {{ include('@WebProfiler/Profiler/toolbar_item.html.twig', { link: profiler_url, name: 'external_http'}) }}
{% endblock %}

{% block menu %}
    <span class="label">
        <span class="icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="#AAA" d="M20.4 12c-1 0-1.8.6-2.2 1.4l-2.6-.9c.1-.3.1-.5.1-.8 0-1.2-.6-2.2-1.5-2.9l1.5-2.6c.3.1.6.2 1 .2 1.4 0 2.5-1.1 2.5-2.5s-1.1-2.5-2.5-2.5-2.5 1.1-2.5 2.5c0 .8.4 1.5.9 1.9l-1.5 2.6c-.5-.3-1-.4-1.6-.4-.9 0-1.7.3-2.3.9L7.4 6.6c.3-.4.5-.9.5-1.5 0-1.4-1.1-2.5-2.5-2.5S2.7 3.7 2.7 5.1s1.1 2.5 2.5 2.5c.6 0 1.1-.2 1.5-.5L9 9.4c-.5.6-.8 1.4-.8 2.3 0 .7.2 1.4.6 2l-3.9 3.8c-.4-.3-.9-.5-1.5-.5C2 17 .9 18.1.9 19.5S2.2 22 3.6 22s2.5-1.1 2.5-2.5c0-.5-.2-1-.5-1.5l3.8-3.7c.7.7 1.6 1.1 2.6 1.1h.2l.4 2.4c-1 .3-1.7 1.3-1.7 2.4 0 1.4 1.1 2.5 2.5 2.5s2.5-1.1 2.5-2.5-1.1-2.5-2.5-2.5l-.4-2.5c1-.3 1.9-1 2.3-2l2.6.9v.4c0 1.4 1.1 2.5 2.5 2.5s2.5-1.1 2.5-2.5c.1-1.4-1.1-2.5-2.5-2.5z"/></svg>
        </span>
        <strong>External Http</strong>
        <span class="count">
            <span>{{ collector.logs|length }}</span>
        </span>
    </span>
{% endblock %}

{% block panel %}
    <style>
        .http-log-table {
            table-layout: auto;
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }
        .http-log-table .col-shrink {
            white-space: nowrap;
            width: 1%;
        }
        .http-log-table .col-fill {
            width: 99%;
        }
        .http-log-table th {
            background: #2e3d50;
            color: #fff;
            padding: 9px 10px;
            text-align: left;
            font-weight: 600;
            font-size: 12px;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }
        .http-log-table td {
            padding: 8px 10px;
            vertical-align: top;
            border-bottom: none;
            background: transparent;
        }
        .http-log-table tbody tr.http-log-row-even td {
            background: rgba(255, 255, 255, 0.03);
        }
        .http-log-table code {
            background: #eef1f5;
            padding: 1px 5px;
            border-radius: 3px;
            font-size: 12px;
            color: #3c4c60;
            word-break: break-all;
        }
        .http-log-table .http-log-method {
            font-weight: 600;
        }
        .http-log-table pre {
            white-space: pre-wrap;
            word-wrap: break-word;
            margin: 0;
            font-size: 12px;
        }
        .http-log-details-row td {
            padding-top: 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }
        .http-log-details-cell {
            padding: 6px 10px 10px 10px;
        }
        .http-log-details-content {
            border-radius: 4px;
            padding: 10px 14px;
            margin-top: 4px;
            overflow-x: auto;
            max-height: 500px;
            overflow-y: auto;
        }
        .http-log-table details {
            padding-top: 4px;
        }
        .http-log-table details summary {
            display: inline-block;
            cursor: pointer;
            font-size: 12px;
            color: #ccc;
            font-weight: 500;
            padding: 3px 10px;
            border-radius: 3px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            background: rgba(255, 255, 255, 0.06);
            user-select: none;
            transition: background 0.12s, border-color 0.12s, color 0.12s;
        }
        .http-log-table details summary:hover {
            background: rgba(255, 255, 255, 0.12);
            border-color: rgba(255, 255, 255, 0.35);
            color: #fff;
        }
        .http-log-table details[open] summary {
            margin-bottom: 6px;
            background: #2e3d50;
            border-color: #2e3d50;
            color: #fff;
        }
        .http-log-empty {
            padding: 40px 20px;
            text-align: center;
            color: #999;
            font-size: 14px;
            border: 1px dashed #ddd;
            border-radius: 6px;
        }
    </style>

    <h2>External Http Requests</h2>

    {% set logs = collector.logs %}

    {% if logs is empty %}
        <div class="http-log-empty">
            No external HTTP requests were captured for this request.
        </div>
    {% else %}
        <table class="http-log-table">
            <thead>
                <tr>
                    <th class="col-shrink">#</th>
                    <th class="col-shrink">Method</th>
                    <th class="col-fill">Url</th>
                </tr>
            </thead>
            <tbody>
                {% for i, log in logs %}
                    <tr class="{% if i is even %}http-log-row-even{% endif %}">
                        <td class="col-shrink">{{ i + 1 }}</td>
                        <td class="col-shrink http-log-method">{{ log.method }}</td>
                        <td><code>{{ log.url }}</code></td>
                    </tr>
                    <tr class="http-log-details-row {% if i is even %}http-log-row-even{% endif %}">
                        <td colspan="3" class="http-log-details-cell">
                            <details>
                                <summary>Show request data</summary>
                                <div class="http-log-details-content">
                                    {{ _self.renderLogValue(log.request_data) }}
                                </div>
                            </details>
                            <details>
                                <summary>Show response data</summary>
                                <div class="http-log-details-content">
                                    {{ _self.renderLogValue(log.response_data) }}
                                </div>
                            </details>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}

{% macro renderLogValue(value) %}
    {% if value is iterable %}
        {{ profiler_dump(value) }}
    {% else %}
        <pre>{{ value }}</pre>
    {% endif %}
{% endmacro %}
